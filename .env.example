# Docker Compose Project Name (used to namespace containers, networks, and volumes)
# Change this if running multiple projects on the same server to avoid conflicts
COMPOSE_PROJECT_NAME=wp_ols

# Database Configuration for Docker Compose
DATABASENAME=databasename
DATABASEUSER=databaseuser
DATABASEPASS=databasepass

# Additional optional configurations
# MYSQL_ROOT_PASSWORD=your_root_password   # Default: rootpassword
# PHP_VERSION=8.3                          # PHP version for the container

# WordPress admin (optional - only used if WP auto-install runs)
# WORDPRESS_ADMIN_USER=admin
# WORDPRESS_ADMIN_PASSWORD=changeme
# WORDPRESS_ADMIN_EMAIL=admin@example.com

# Add WebAdmin credentials for OpenLiteSpeed
OLS_ADMIN_USER=admin
OLS_ADMIN_PASSWORD=P@ssw0rd
