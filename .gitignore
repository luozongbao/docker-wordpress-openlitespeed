# WordPress files
www/*
!www/.gitkeep

# Logs files folder
logs/*
!logs/.gitkeep

# Database dumps
database/*
!database/.gitkeep

# Secrets / local config
.env
*.bak
*.old
*.conf.bak

# Archives
*.zip
*.tar.gz

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*~

# Editor backups (e.g. foo.conf.txt, foo.conf0, #foo.conf#)
*.conf.txt
*.conf.bak
*.conf0
*.conf~
*#
